NODE_ENV="development"

# MongoDB - Required for database connection
MONGO_URI="mongodb://127.0.0.1:27017/hospital"

# Better Auth - Required for authentication (32-byte hex secret)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5000"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"

# Google Gemini AI - Optional (for AI medical analysis features)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_KEY=""

# UploadThing - Optional (for file uploads like X-rays)
# Get from: https://uploadthing.com
UPLOADTHING_TOKEN=""

# Polar API - Optional (for payments/subscriptions)
# Get from: https://polar.sh
POLAR_PRODUCT_ID=""
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
