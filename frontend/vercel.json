{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "bun run build",
  "outputDirectory": "build/client",
  "build": {
    "env": {
      "VITE_API_URL": "https://medflow-backend-zcm0.onrender.com",
      "VITE_SOCKET_URL": "https://medflow-backend-zcm0.onrender.com"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
